# Migration Dockerfile - includes dev dependencies for seeding
FROM node:20-alpine

# Install OpenSSL for Prisma
RUN apk add --no-cache openssl

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install all dependencies (including dev for ts-node)
RUN npm ci

# Generate Prisma client
RUN npx prisma generate

# Copy source files for seeding
COPY tsconfig.json ./

# Default command
CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma db seed"]
